{
  "name": "feednest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FeedNest - a local-first RSS/Atom reader that keeps your reading in your own browser.",
  "license": "MIT",
  "homepage": "https://iiiiiiiiiiiiikk.github.io/feednest/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiiiiiiiiiiiiKK/feednest.git"
  },
  "bugs": {
    "url": "https://github.com/iiiiiiiiiiiiiKK/feednest/issues"
  },
  "keywords": [
    "rss",
    "atom",
    "feed-reader",
    "indexeddb",
    "local-first",
    "react",
    "vite",
    "pwa"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "fixtures": "node scripts/fixture-server.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
